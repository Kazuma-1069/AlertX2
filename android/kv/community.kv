#:import REPORT_TYPES app.screens.community.REPORT_TYPES

<CommunityScreen>:
    md_bg_color: 0.051, 0.067, 0.090, 1   # #0D1117

    MDBoxLayout:
        orientation: "vertical"
        spacing: 0

        # ── App Bar ────────────────────────────────────────────────────────
        MDTopAppBar:
            title: "Community Report"
            left_action_items: [["arrow-left", lambda x: root.go_back()]]
            md_bg_color: 0.086, 0.106, 0.133, 1   # #161B22
            specific_text_color: 0.941, 0.965, 0.988, 1   # #F0F6FC
            elevation: 2

        # ── Scrollable body ────────────────────────────────────────────────
        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: "16dp"
                spacing: "16dp"
                adaptive_height: True

                # ── Intro text ─────────────────────────────────────────────
                MDLabel:
                    text: "Help your neighbours by reporting local incidents."
                    theme_text_color: "Custom"
                    text_color: 0.545, 0.580, 0.620, 1   # #8B949E
                    font_style: "Body1"
                    adaptive_height: True

                # ── Report Type Card ───────────────────────────────────────
                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "12dp"
                    adaptive_height: True
                    md_bg_color: 0.086, 0.106, 0.133, 1   # #161B22
                    radius: [8, 8, 8, 8]
                    line_color: 0.188, 0.212, 0.239, 1   # #30363D

                    MDLabel:
                        text: "Incident Type"
                        theme_text_color: "Custom"
                        text_color: 0.941, 0.965, 0.988, 1   # #F0F6FC
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True

                    Spinner:
                        id: report_type_spinner
                        text: "Select Report Type"
                        values: REPORT_TYPES
                        size_hint_y: None
                        height: "48dp"
                        background_color: 0.086, 0.106, 0.133, 1
                        color: 0.941, 0.965, 0.988, 1
                        option_cls: "SpinnerOption"
                        font_size: "15sp"

                # ── Description Card ───────────────────────────────────────
                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "12dp"
                    adaptive_height: True
                    md_bg_color: 0.086, 0.106, 0.133, 1
                    radius: [8, 8, 8, 8]
                    line_color: 0.188, 0.212, 0.239, 1

                    MDLabel:
                        text: "Description"
                        theme_text_color: "Custom"
                        text_color: 0.941, 0.965, 0.988, 1
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True

                    TextInput:
                        id: description_input
                        hint_text: "Describe what you saw — include location details, severity, and any other relevant information..."
                        multiline: True
                        size_hint_y: None
                        height: "120dp"
                        background_color: 0.051, 0.067, 0.090, 1
                        foreground_color: 0.941, 0.965, 0.988, 1
                        hint_text_color: 0.545, 0.580, 0.620, 1
                        cursor_color: 0.851, 0.176, 0.125, 1   # #D92D20
                        font_size: "15sp"
                        padding: ["8dp", "8dp"]

                # ── Location Card ──────────────────────────────────────────
                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "10dp"
                    adaptive_height: True
                    md_bg_color: 0.086, 0.106, 0.133, 1
                    radius: [8, 8, 8, 8]
                    line_color: 0.188, 0.212, 0.239, 1

                    MDLabel:
                        text: "Location"
                        theme_text_color: "Custom"
                        text_color: 0.941, 0.965, 0.988, 1
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: "8dp"
                        adaptive_height: True

                        MDIcon:
                            icon: "map-marker"
                            theme_text_color: "Custom"
                            text_color: 0.914, 0.639, 0.098, 1   # #E9A319
                            size_hint_x: None
                            width: "24dp"

                        MDLabel:
                            id: location_label
                            text: "Location not set"
                            theme_text_color: "Custom"
                            text_color: 0.545, 0.580, 0.620, 1
                            font_style: "Body2"
                            adaptive_height: True

                    MDRaisedButton:
                        text: "Get My Location"
                        on_release: root.get_location()
                        md_bg_color: 0.086, 0.106, 0.133, 1
                        line_color: 0.914, 0.639, 0.098, 1
                        theme_text_color: "Custom"
                        text_color: 0.914, 0.639, 0.098, 1
                        size_hint_x: 1

                # ── Submit Button ──────────────────────────────────────────
                MDRaisedButton:
                    id: submit_btn
                    text: "Submit Report"
                    on_release: root.submit_report()
                    md_bg_color: 0.851, 0.176, 0.125, 1   # #D92D20
                    size_hint_x: 1
                    height: "52dp"
                    font_size: "16sp"
                    bold: True

                # ── Helper text ────────────────────────────────────────────
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "6dp"
                    adaptive_height: True

                    MDIcon:
                        icon: "shield-check"
                        theme_text_color: "Custom"
                        text_color: 0.545, 0.580, 0.620, 1
                        size_hint_x: None
                        width: "18dp"

                    MDLabel:
                        text: "Reports help keep your community safe"
                        theme_text_color: "Custom"
                        text_color: 0.545, 0.580, 0.620, 1
                        font_style: "Caption"
                        adaptive_height: True
