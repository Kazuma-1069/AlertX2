# AlertX2 Environment Variables

# Application
APP_NAME=AlertX2
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./alertx2.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://alertx_user:password@localhost:5432/alertx2_db

# Twilio (SMS & Emergency Voice Calling)
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Maps / Geolocation
GOOGLE_MAPS_API_KEY=mock_google_maps_api_key

# AI Safety Assistant (Gemini / OpenAI)
AI_API_KEY=mock_ai_api_key
AI_MODEL_NAME=gemini-1.5-flash

# Redis / Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0
